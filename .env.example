DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_ENGINE unset (or blank) to use SQLite — zero setup, works immediately.
# Set DB_ENGINE=mysql to use MySQL instead, and fill in the fields below.
DB_ENGINE=
DB_NAME=sivasakthi_holidays
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Optional — leave blank to print emails to the console instead of sending them.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
